<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ColorSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".TimeSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".TimeZoneDualActivity"
            android:exported="false" />
        <!-- LSPosed / Xposed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="RAM Status Bar" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <!-- 自动勾选作用域：android + com.android.systemui -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <!-- 内置下载 APK 安装：FileProvider 提供 content:// 访问 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.github.gjr787878.ramstatusbar.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
